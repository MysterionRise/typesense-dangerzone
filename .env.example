# Typesense Configuration
# Copy this file to .env and fill in your values

# Required: Typesense API key
# For local development, this should match the key in docker-compose.yml
TYPESENSE_API_KEY=your-secure-api-key-here

# Optional: Connection settings (defaults shown)
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http

# Optional: Timeout settings (defaults shown)
# TYPESENSE_CONNECTION_TIMEOUT_SECONDS=5
# TYPESENSE_SEARCH_TIMEOUT_SECONDS=10

# Optional: Default collection name
# TYPESENSE_DEFAULT_COLLECTION=movies
